# --- Server ---
PORT=4000
NODE_ENV=development

# --- JWT ---
# Estrategia simetrica (HMAC) para MVP-03. Si se migra a RSA/ECDSA,
# reemplazar por JWT_PRIVATE_KEY_PATH / JWT_PUBLIC_KEY_PATH y actualizar
# src/adapters/services/JwtTokenService.js
JWT_SECRET=change-me-in-every-environment
JWT_EXPIRES_IN_SECONDS=28800

# --- Staff credentials (para POST /invitations, PA-01-T2) ---
# Se envian como HTTP Basic Auth: Authorization: Basic base64(usuario:password).
# El servicio no arranca si alguna esta vacia.
STAFF_USERNAME=staff-admin
STAFF_PASSWORD=change-me-too

# --- Password hashing ---
BCRYPT_SALT_ROUNDS=10

# --- Database / Redis ---
# Valores para `npm run dev` fuera de Docker (bases levantadas con
# `docker compose up postgres redis`). docker-compose.yml los sobrescribe
# para el contenedor del servicio.
DATABASE_URL=postgres://auth:auth@localhost:55432/auth
REDIS_URL=redis://localhost:6380

# --- Invitaciones (PA-03) ---
# Segundos que un codigo de invitacion sigue siendo valido tras generarse.
INVITATION_TTL_SECONDS=300

# --- Tests de integracion ---
# true para correr los tests contra Postgres y Redis reales.
RUN_INTEGRATION_TESTS=false
