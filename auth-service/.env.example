# --- Server ---
PORT=4000
NODE_ENV=development

# --- JWT ---
# Estrategia simetrica (HMAC) para MVP-03. Si se migra a RSA/ECDSA,
# reemplazar por JWT_PRIVATE_KEY_PATH / JWT_PUBLIC_KEY_PATH y actualizar
# src/adapters/services/JwtTokenService.js
JWT_SECRET=change-me-in-every-environment
JWT_EXPIRES_IN_SECONDS=28800

# --- Staff credentials (para POST /invitations, PA-01-T2) ---
# Se envian como HTTP Basic Auth: Authorization: Basic base64(usuario:password).
# El servicio no arranca si alguna esta vacia.
STAFF_USERNAME=staff-admin
STAFF_PASSWORD=change-me-too

# --- Password hashing ---
BCRYPT_SALT_ROUNDS=10

# --- Rate limit (POST /auth/login y POST /invitations) ---
# Tras RATE_LIMIT_MAX_FAILED credenciales rechazadas (401) desde una IP dentro
# de la ventana, la ruta responde 429 hasta que la ventana se reinicia. Las
# respuestas exitosas y los 400 no cuentan. El contador vive en memoria (por replica).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_FAILED=10
# Detras de un proxy inverso, para que el limite use la IP real del cliente:
# true, un numero de saltos (1) o una lista de subredes (loopback, 10.0.0.0/8).
TRUST_PROXY=false

# --- Database / Redis ---
# Valores para `npm run dev` fuera de Docker (bases levantadas con
# `docker compose up postgres redis`). docker-compose.yml los sobrescribe
# para el contenedor del servicio.
DATABASE_URL=postgres://auth:auth@localhost:55432/auth
REDIS_URL=redis://localhost:6380

# --- Invitaciones (PA-03) ---
# Segundos que un codigo de invitacion sigue siendo valido tras generarse.
INVITATION_TTL_SECONDS=300

# --- Resiliencia: Fallback(CircuitBreaker(Budget(Retry(Timeout(llamada))))) ---
# Timeout de cada intento contra Postgres y Redis (ms). En Postgres tambien
# es el query_timeout del driver.
PG_TIMEOUT_MS=2000
REDIS_TIMEOUT_MS=500
# Tiempo maximo de la llamada completa, reintentos incluidos (ms): con el
# store caido, el 503 llega en este tiempo como mucho.
PG_BUDGET_MS=3000
REDIS_BUDGET_MS=1000
# Reintentos tras el primer intento, con backoff exponencial y jitter. Solo
# para operaciones idempotentes (lecturas y comandos de Redis).
RETRY_MAX_ATTEMPTS=2
RETRY_INITIAL_DELAY_MS=100
RETRY_MAX_DELAY_MS=1000
# Fallos seguidos que abren el circuito de un store, y cuanto tarda en dejar
# pasar una llamada de prueba (tambien es el valor de Retry-After del 503).
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_HALF_OPEN_AFTER_MS=10000

# --- Tests de integracion ---
# true para correr los tests contra Postgres y Redis reales.
RUN_INTEGRATION_TESTS=false
